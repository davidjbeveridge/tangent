#!/bin/sh
# Tangent AppImage launcher. Keep Chromium's sandbox enabled even when the
# host cannot provide user namespaces; failing to launch is safer than silently
# running arbitrary websites without the operating-system sandbox.
set -eu

for argument in "$@"; do
  case "$argument" in
    --no-sandbox|--no-sandbox=*|--disable-gpu-sandbox|--disable-gpu-sandbox=*|--disable-setuid-sandbox|--disable-setuid-sandbox=*|--disable-seccomp-filter-sandbox|--disable-seccomp-filter-sandbox=*)
      printf '%s\n' "Tangent cannot start with Chromium's sandbox disabled. Remove the sandbox-disabling argument from the launcher." >&2
      exit 1
      ;;
  esac
done

APPDIR=$(dirname -- "$(readlink -f -- "$0")")
export APPDIR
export PATH="$APPDIR:$APPDIR/usr/sbin${PATH:+:$PATH}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}:/usr/local/share:/usr/share"
export LD_LIBRARY_PATH="$APPDIR/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas"

if "$APPDIR/tangent-browser" "$@"; then
  exit 0
else
  result=$?
  printf '%s\n' "Tangent stopped with exit code $result. Linux requires a regular user account and a working Chromium user-namespace sandbox. If the diagnostic above mentions namespaces, AppArmor, or chrome-sandbox, ask your administrator to allow the application under the system's sandbox policy. Tangent will not disable the sandbox automatically." >&2
  exit "$result"
fi
